# ─── Java / Maven ──────────────────────────────────────────────────────────────
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.ear
*.log

# ─── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/settings.json
*.iml
*.iws
*.ipr
.classpath
.project
.settings/

# ─── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
