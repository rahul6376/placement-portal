# ──────────────────────────────────────────────────────────────────────────────
# BKBIET Placement Portal — Backend Environment Variables
# Copy this file to .env and fill in the values before running.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# Database (Supabase)
DATABASE_URL=jdbc:postgresql://db.<your-project-id>.supabase.co:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=<your-supabase-db-password>

# JWT — generate a strong random key (min 64 hex chars):
# Run: openssl rand -hex 64
JWT_SECRET=<replace-with-64-char-random-hex>
JWT_EXPIRATION=86400000

# JPA DDL
# Use "update" for first local run, then switch to "validate" for safety
JPA_DDL_AUTO=validate

# Server port
PORT=8081

# CORS — comma-separated list of allowed frontend origins
# Example: http://localhost:5173,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
