# ──────────────────────────────────────────────────────────────────────────────
# BKBIET Placement Portal — Frontend Environment Variables
# Copy this file to .env and fill in the values before running/deploying.
# ──────────────────────────────────────────────────────────────────────────────

# Backend API base URL
# Local development:
VITE_API_URL=http://localhost:8081

# Production (set to your deployed backend URL, e.g. Railway/Render):
# VITE_API_URL=https://api.your-domain.com
